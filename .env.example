# Bulletproof RAG — Environment Variables
# Copy this file to .env and fill in your values.

# ── LLM Provider ──────────────────────────────────────────────
# Supported providers: "openai", "anthropic", "openai_compatible"
LLM_PROVIDER="openai_compatible"
LLM_MODEL="Qwen/Qwen2.5-32B-Instruct-AWQ"
LLM_BASE_URL="http://localhost:8000/v1"
LLM_API_KEY="sk-1234"
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.0

# ── Vector Store ──────────────────────────────────────────────
VECTOR_BACKEND="chromadb"
VECTOR_URL="http://localhost:8001"
VECTOR_COLLECTION_NAME="default"

# ── Embedding ─────────────────────────────────────────────────
EMBEDDING_MODEL_NAME="all-MiniLM-L6-v2"
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DIMENSIONS=384

# ── Pipeline ──────────────────────────────────────────────────
PIPELINE_MAX_ITERATIONS=3
PIPELINE_RELEVANCE_THRESHOLD=3.0
PIPELINE_ENABLE_HALLUCINATION_CHECK=true
